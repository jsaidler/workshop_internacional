+function student_process_agitation_input(array $input): array {
+    $legacy=student_workspace_text($input['agitation']??'',600);
+    $mode=trim((string)($input['agitation_mode']??''));
+    $durationRaw=student_workspace_text($input['agitation_duration']??'',40);
+    $intervalRaw=student_workspace_text($input['agitation_interval']??'',40);
+    if(!in_array($mode,['none','periodic','continuous'],true)){
+        $fold=mb_strtolower($legacy);
+        if(str_contains($fold,'contín')||str_contains($fold,'contin'))$mode='continuous';
+        elseif($intervalRaw!=='')$mode='periodic';
+        else $mode='none';
+    }
+    $duration='';$interval='';
+    if($mode==='periodic'){
+        $durationSeconds=student_process_time_seconds($durationRaw);
+        $intervalSeconds=student_process_time_seconds($intervalRaw);
+        if($durationSeconds===null||$durationSeconds<=0)throw new RuntimeException('Informe quanto tempo dura cada agitação.');
+        if($intervalSeconds===null||$intervalSeconds<=0)throw new RuntimeException('Informe o intervalo entre o início de cada agitação.');
+        if($durationSeconds>=$intervalSeconds)throw new RuntimeException('A duração da agitação deve ser menor que o intervalo. Para agitação sem pausa, escolha Contínua.');
+        $duration=student_process_seconds_label($durationSeconds);$interval=student_process_seconds_label($intervalSeconds);
+    }
+    return ['mode'=>$mode,'duration'=>$duration,'interval'=>$interval,'description'=>$legacy];
+}
