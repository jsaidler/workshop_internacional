{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct Positive Workshop Content",
  "type": "object",
  "required": [
    "version",
    "template",
    "sections",
    "texts",
    "images",
    "videos",
    "forms"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "template": {
      "const": "direct-positive-workshop"
    },
    "theme": {
      "enum": [
        "auto",
        "light",
        "dark"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "visible",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "html"
        ],
        "properties": {
          "html": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "src",
          "alt"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "objectFit": {
            "enum": [
              "cover",
              "contain",
              "fill",
              "none",
              "scale-down"
            ]
          },
          "objectPosition": {
            "type": "string"
          },
          "positionX": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "positionY": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "videos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "poster": {
            "type": "string"
          },
          "autoplay": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          },
          "loop": {
            "type": "boolean"
          },
          "controls": {
            "type": "boolean"
          },
          "aspectRatio": {
            "type": "string"
          }
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields"
        ],
        "properties": {
          "submitLabel": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "label",
                "required"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "text",
                    "email",
                    "textarea",
                    "radio",
                    "checkbox",
                    "select"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "placeholder": {
                  "type": "string"
                },
                "help": {
                  "type": "string"
                },
                "rows": {
                  "type": "integer"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
